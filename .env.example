# ─────────────────────────────────────────────────────────────────────────────
# CrushBoard environment variables
#
# With NO variables set, the app boots in demo mode: seeded data, one-click
# demo login, everything works locally. Copy this file to .env.local and fill
# in the Supabase values to switch to production mode.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — private (server/edge only, NEVER expose to the browser).
# Used only by lib/supabase/admin.ts (signed photo URLs) and the edge functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of the app — used for portal links and magic-link redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — FingerprintJS Pro API key (the free tier needs none).
NEXT_PUBLIC_FPJS_API_KEY=

# Optional — Resend (notify listers of new applications).
RESEND_API_KEY=
